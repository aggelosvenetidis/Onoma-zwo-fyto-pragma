# Αντέγραψε σε .env και συμπλήρωσε. ΠΟΤΕ μην ανεβάσεις το .env στο GitHub.

# Θύρα (το Render την ορίζει μόνο του)
PORT=3000

# Κλειδί Claude API για έλεγχο κατηγορίας (προαιρετικό — χωρίς αυτό
# οι άγνωστες λέξεις γίνονται δεκτές με "?" και κρίνονται με αμφισβήτηση)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Από ποιο origin επιτρέπονται συνδέσεις socket (* = όλα).
# Αν frontend και backend είναι στο ίδιο service, άφησέ το *.
CLIENT_ORIGIN=*
